## 4.4 CLASS DIAGRAM

```mermaid
classDiagram
    %% Core Model and Preprocessing Classes
    
    class TextNormalizer {
        +String language
        +normalize(text: String) String
        -_clean_whitespace(text: String) String
        -_expand_abbreviations(text: String) String
        -_expand_currency(text: String) String
        -_expand_numbers(text: String) String
    }

    class AudioProcessor {
        +int sample_rate
        +int n_fft
        +int n_mels
        +load_audio(path: String) Tensor
        +get_mel_spectrogram(waveform: Tensor) Tensor
        +get_linear_spectrogram(waveform: Tensor) Tensor
        +extract_features(waveform: Tensor) Tensor
    }

    class STTDataset {
        +String manifest_path
        +__init__(manifest_path, audio_processor)
        +__getitem__(idx: int) Dict
        +__len__() int
    }

    class TTSDataset {
        +String filelist_path
        +__init__(filelist_path, audio_processor, text_normalizer)
        +__getitem__(idx: int) Dict
        +__len__() int
    }

    class VITS2 {
        +int vocab_size
        +forward(x, x_lengths, y, y_lengths) Dict
        +infer(x, x_lengths, noise_scale, length_scale) Tensor
    }

    class TextEncoder {
        +forward(x, x_lengths) Tensor
    }
    
    class HiFiGANGenerator {
        +forward(x) Tensor
    }

    class ConformerCTC {
        +int vocab_size
        +forward(features, feat_lengths) Tensor
        +decode(features, feat_lengths) List~Int~
        +beam_decode(features, feat_lengths, beam_width) List~Int~
    }
    
    class ConformerEncoder {
        +forward(x, mask) Tensor
    }

    class CTCLoss {
        +int blank_id
        +forward(log_probs, targets, input_len, target_len) float
    }

    %% Relationships
    TTSDataset --> TextNormalizer : Uses
    TTSDataset --> AudioProcessor : Uses
    STTDataset --> AudioProcessor : Uses
    
    VITS2 *-- TextEncoder : Contains
    VITS2 *-- HiFiGANGenerator : Contains
    
    ConformerCTC *-- ConformerEncoder : Contains
    ConformerCTC ..> CTCLoss : Trained With
```
